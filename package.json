{
  "name": "ridu-api-studio",
  "productName": "Ridu API Studio",
  "version": "0.1.0",
  "description": "Desktop API development and testing application",
  "author": "RiduAPI Team",
  "license": "MIT",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:renderer": "vite",
